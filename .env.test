# Loaded automatically by Vite/Vitest in test mode. Fake but well-formed
# values so modules that construct a Supabase client at import time (e.g.
# src/lib/supabaseClient.js) don't throw during test collection. No network
# calls are made in tests -- Supabase itself is mocked per-test where needed.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_BACKEND_URL=http://localhost:3000/api
